<div class="feature-organizer">
    <label class="feature-organizer-filter">
        <input type="checkbox" data-action="show-hidden">
        Show hidden features
    </label>

    <button
        type="button"
        class="feature-organizer-group-toggle"
        data-action="toggle-grouping"
        aria-pressed="false"
        title="Grouping by subtype: disabled"
    >
        <i class="fa-solid fa-toggle-off"></i>
        Group by subtype
    </button>
</div>